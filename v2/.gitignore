# ============ V0.2 运行时产物（阶段 5 清理） ============
# 本文件只作用于 v2/ 内部（路径相对 v2/）。仓库根 .gitignore 不动，
# 保证 V0.1 / 仓库根文件零改动（阶段 5 验收 T20）。

# v2 项目数据与运行日志：运行时生成，绝不进版本库
projects/
logs/llm_calls.jsonl
logs/**/llm_calls.jsonl

# 各阶段测试的运行日志 / 临时产物
# （run_tests.py 与 stage*_report.md/json 保留为验收证据，不忽略）
logs/**/console.txt
logs/**/real_console.txt
logs/**/tmp_projects/
logs/**/tmp_logs/
logs/**/real_tmp/
logs/**/project_*/
logs/**/runs/
logs/**/test_output_*

# ---------- Stage 10 视觉资产的运行时产物（不忽略脚本/报告/结构化 JSON 证据） ----------
# 1) 真实/临时项目目录下的图片本体与注册表：二进制素材，绝不进版本库
#    （结构证据由 stage*_report.md / real_run_report.json 承载，不含图片本体）
logs/**/visual_assets/images/
logs/**/visual_assets/registry.json
# 2) 真实冒烟运行目录：真实 API 调用产生的项目目录（含图片 + 注册表快照）
logs/**/real_smoke_single_image/
logs/**/real_project/
# 3) 真实 API 记账 / 临时产物（token 明细含 prompt 统计与耗时，属运行产物）
logs/**/real_vision_calls.jsonl
logs/**/real_llm_calls.jsonl
logs/**/image_generation_calls.jsonl

# ---------- API 调用记账文件（全局兜底，任意层级） ----------
# llm/client.py 与 TokenLogger 默认写当前工作目录的 llm_calls.jsonl；
# 上一条 logs/**/ 只覆盖 logs 子树，故此处显式兜底 v2/ 与仓库根。
llm_calls.jsonl
**/llm_calls.jsonl

# ---------- ★ Stage 13 图像产物（二进制大文件，绝不进版本库） ----------
# 生成的真实图片是二进制大文件：一旦入库仓库迅速膨胀且无法回退。
# 保留（**不忽略**）：manifest.json（结构化证据）、脚本、报告、结构化 JSON。
logs/**/generated_images/
logs/**/images/
logs/**/tmp_*/generated_images/
**/generated_images/*.png
**/generated_images/*.jpg
**/generated_images/*.jpeg
**/generated_images/*.webp

# ---------- ★ Stage 15 视频产物（二进制大文件，绝不进版本库） ----------
# 生成的真实视频片段是二进制大文件；保留 manifest.json（结构化证据）与报告。
logs/**/generated_videos/
**/generated_videos/*.mp4
**/generated_videos/*.mov
**/generated_videos/*.webm
logs/**/video_generation_calls.jsonl
logs/**/tmp_*/generated_videos/

# Python 运行时缓存（根 .gitignore 已覆盖，这里冗余自包含）
__pycache__/
*.py[cod]
